# --- Optional Google Maps sidecar (additive feature) ---
# Copy these lines into .env only when you want to use it.
# Nothing changes while GMAPS_ENABLED is false (the default).

GMAPS_ENABLED=false

# docker (default) or binary
GMAPS_MODE=docker
GMAPS_IMAGE=gosom/google-maps-scraper
GMAPS_BINARY=google-maps-scraper
GMAPS_CACHE_VOLUME=gmaps-playwright-cache

# Files created by this feature (new directory only)
# GMAPS_WORK_DIR=./data/gmaps

# Keep these low at first — higher values get blocked more often
GMAPS_DEPTH=1
GMAPS_CONCURRENCY=2
GMAPS_MAX_QUERIES=50
GMAPS_TIMEOUT_MS=900000

# Optional extra scraper flags, e.g. "-lang en"
GMAPS_EXTRA_ARGS=

# Allow medium-confidence name + location matching
GMAPS_ALLOW_NAME_LOCATION_MATCH=true
