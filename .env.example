# Leadmoz - environment template
#
# Copy to `.env` and fill in what you need. The app runs WITHOUT optional
# providers: every key marked "optional" only enables an extra capability, and
# nothing crashes when it is missing. Never put real secrets in this file.
#
# Loaded from the working directory's `.env` (src/config.js), and only when the
# variable is not already set in the process environment.

# ---------------------------------------------------------------- core
PORT=5050
SITE_URL=https://leadmoz.com
PUBLIC_BASE_URL=https://leadmoz.com
DEFAULT_COUNTRY=US

# ---------------------------------------------------------------- auth / admin
# Comma-separated addresses that get role "admin" on signup.
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_EMAIL=
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- transactional + campaign mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
PLATFORM_SMTP_ALLOWED_USERS=
CAMPAIGN_EMAIL_ENABLED=true
ADMIN_DAILY_SEND_LIMIT=
PRO_DAILY_SEND_LIMIT=
ADMIN_WHATSAPP_NUMBER=

# ---------------------------------------------------------------- AI (optional)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=
AI_CALL_TIMEOUT_MS=
AI_KEY_COOLDOWN_MS=
AI_KEY_AUTH_COOLDOWN_MS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=
CLOUDFLARE_AI_MAX_TOKENS=
CLOUDFLARE_AI_TIMEOUT_MS=

# ---------------------------------------------------------------- discovery / scraping (optional)
FIRECRAWL_API_KEY=
FIRECRAWL_API_KEYS=
FIRECRAWL_API_KEYS_PAID=
FIRECRAWL_CALLS_PER_RUN=
FIRECRAWL_SEARCH_LIMIT=
FIRECRAWL_TIMEOUT_MS=
TAVILY_API_KEY=
TAVILY_API_KEYS=
TAVILY_API_KEYS_PAID=
TAVILY_CALLS_PER_RUN=
TAVILY_COUNTRY=
TAVILY_MAX_RESULTS=
TAVILY_TIMEOUT_MS=
LANGSEARCH_API_KEY=
LANGSEARCH_API_KEYS=
LANGSEARCH_ATTEMPTS=
LANGSEARCH_MAX_RESULTS=
LANGSEARCH_TIMEOUT_MS=
SEARXNG_URL=
SEARXNG_MODE=
SEARXNG_TIMEOUT_MS=
OSM_ENABLED=
OSM_USER_AGENT=
SCRAPE_TIMEOUT_MS=
DEBUG_SEARCH=
FREE_ENGINES=
WEB_SEARCH_DEADLINE_MS=
SEARCH_CALLS_PER_KEY=
SEARCH_ESCALATION_DEADLINE_MS=
ENGINE_COOLDOWN_MS=

# ---------------------------------------------------------------- ICP / lead quality
ICP_TARGET_NICHES=
ICP_EXCLUDE_NICHES=
ICP_MIN_RATING=
ICP_MIN_REVIEWS=
ICP_REQUIRE_WEBSITE=
PRIORITY_LEAD_THRESHOLD=
FREE_AUDIT_LEAD_LIMIT=

# ---------------------------------------------------------------- plans / jobs
INTRO_CREDITS=
INTRO_CREDITS_CUTOVER=
STALE_JOB_MINUTES=
JOB_RESUME_ATTEMPTS=
JOB_AUTO_RETRY_MAX=
JOB_RETRY_DELAY_MS=
# <PLAN>_DAILY_LEAD_LIMIT, e.g. STARTER_DAILY_LEAD_LIMIT=150 (optional override)

# ---------------------------------------------------------------- rate limiting / abuse guard
ABUSE_GENERATIONS_PER_IP_PER_HOUR=
ABUSE_SIGNUP_PER_IP_PER_HOUR=
ABUSE_VERIFY_EMAIL_PER_IP_PER_HOUR=
ABUSE_VERIFY_EMAIL_PER_ADDRESS_PER_HOUR=
ABUSE_DEVICE_ACCOUNTS_MAX=

# ---------------------------------------------------------------- Paddle billing
# mode: "sandbox" or "live". If unset, a configured client token decides it.
PADDLE_MODE=
PADDLE_ENVIRONMENT=
PADDLE_CLIENT_TOKEN=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# JSON map of price ids per plan and cycle - required for card payments.
# {"starter":{"monthly":"pri_...","3month":"pri_...","6month":"pri_...","yearly":"pri_..."},
#  "pro":{...},"agency":{...}}
PADDLE_PRICES=

# ---------------------------------------------------------------- Company & Contact Enrichment add-on
# Add-on is PAID-PLAN ONLY (see ENRICHMENT_REQUIRE_BASE_PLAN) and its price is
# tiered by the buyer's base plan: Starter $10, Pro $20, Agency $30/month.
#
# REQUIRED to expose the feature at all: at least one Paddle price id for the
# add-on. Prefer the per-tier ids below; without any of them every enrichment
# endpoint answers 503 and the dashboard section shows "not available".
PADDLE_ENRICHMENT_PRICE_STARTER=
PADDLE_ENRICHMENT_PRICE_PRO=
PADDLE_ENRICHMENT_PRICE_AGENCY=
# Legacy single price id - used as the fallback for every tier that has no
# per-tier id above.
PADDLE_ENRICHMENT_PRICE=

# Optional overrides (defaults shown). Allowance and per-step costs are
# configurable here - never hardcoded in the app.
ENRICHMENT_ENABLED=true
# Add-on prices per tier; the flat ENRICHMENT_PRICE_MONTHLY, when set, applies
# to all three tiers instead of these defaults.
ENRICHMENT_PRICE_STARTER=10
ENRICHMENT_PRICE_PRO=20
ENRICHMENT_PRICE_AGENCY=30
# Included monthly allowance per tier (defaults shown). The flat
# ENRICHMENT_MONTHLY_CREDITS, when set, still applies to every tier that has
# no per-tier value above it.
ENRICHMENT_MONTHLY_CREDITS_STARTER=50
ENRICHMENT_MONTHLY_CREDITS_PRO=100
ENRICHMENT_MONTHLY_CREDITS_AGENCY=200
ENRICHMENT_COST_PROFILE=1
ENRICHMENT_COST_DECISION_MAKER=2
ENRICHMENT_COST_EMAIL=3
ENRICHMENT_REQUIRE_BASE_PLAN=true
ENRICHMENT_MAX_DOMAINS_PER_JOB=50
ENRICHMENT_MAX_CSV_ROWS=200
ENRICHMENT_JOBS_PER_HOUR=30
ENRICHMENT_CONCURRENCY=2
ENRICHMENT_PROVIDER_TIMEOUT_MS=20000
ENRICHMENT_SCRAPE_TIMEOUT_MS=60000
# Whole-site read: how many pages of one company's own site a single
# enrichment may fetch (homepage included; the contact/legal pages share the
# same budget). The crawl stays on the submitted domain and is never recursive.
ENRICHMENT_CRAWL_MAX_PAGES=12
ENRICHMENT_CACHE_TTL_DAYS=30
ENRICHMENT_MAX_RETRIES=2
ENRICHMENT_EMAILS_PER_COMPANY=15
# Built-in email finder: keyless. Finds a named person's likely address from
# common layouts and confirms it against the company's own MX server (RCPT
# only - no message is ever sent). No account, no per-lookup fee.
ENRICHMENT_FREE_EMAIL_ENABLED=true
ENRICHMENT_FREE_EMAIL_DAILY_MAX=1000
ENRICHMENT_FREE_EMAIL_VERIFY_MAX=5
ENRICHMENT_FREE_EMAIL_FIND_MAX=3
ENRICHMENT_FREE_EMAIL_PATTERNS_PER_PERSON=3
ENRICHMENT_FREE_EMAIL_TIMEOUT_MS=6000
# Hunter.io is OPTIONAL. The built-in finder above works without it; a key
# only adds Hunter's own database results on top.
HUNTER_API_KEY=
ENRICHMENT_HUNTER_DAILY_MAX=20
# Web-search research (owner discovery beyond the company's own site).
# Reuses the existing TAVILY_API_KEYS / FIRECRAWL_API_KEYS - no new account.
ENRICHMENT_WEB_SEARCH_ENABLED=true
ENRICHMENT_WEB_SEARCH_DAILY_MAX=30
ENRICHMENT_WEB_SEARCH_QUERIES_PER_COMPANY=2
ENRICHMENT_WEB_SEARCH_PAGES_PER_COMPANY=4
# Person-level research: once a decision-maker is NAMED, search the public
# web for that person (LinkedIn/X profile first) instead of only the company.
ENRICHMENT_WEB_SEARCH_QUERIES_PER_PERSON=2
ENRICHMENT_WEB_SEARCH_PAGES_PER_PERSON=3
ENRICHMENT_HUNTER_EMAILS_PER_COMPANY=10
